{
  "name": "dsh-better-dsh",
  "version": "0.10.1",
  "description": "Better DSH: a DSH plugin bundle that installs workflow skills, engineering presets, and five independent plugins (goal, subagent, compact, ask-user, ptc). Pure ESM, no build step.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-dev/dsh-better-dsh.git"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./presets/*": "./presets/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "scripts": {
    "test": "node --test",
    "prompts": "node scripts/render-prompts.mjs",
    "smoke": "node scripts/runtime-smoke.mjs"
  },
  "files": [
    "src",
    "docs/DEVELOPMENT.md",
    "docs/UI-KIT.md",
    "docs/assets",
    "skills",
    "presets",
    "third-party",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "better-dsh",
    "omdsh-dev",
    "workflow",
    "orchestration",
    "agent-preset"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "js-yaml": "^4.2.0",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "@oh-my-dsh/dsh-better-subagent": "0.5.0",
    "dsh-better-ask-user": "0.3.1",
    "dsh-better-compact": "0.3.1",
    "dsh-better-goal": "0.4.1",
    "dsh-better-ptc": "0.2.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/eng.patch.yml",
        "./presets/eng-ptc.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "homepage": "https://github.com/omdsh-dev/dsh-better-dsh#readme",
  "bugs": {
    "url": "https://github.com/omdsh-dev/dsh-better-dsh/issues"
  }
}
